{
  "name": "glossquote-random-groups",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  },
  "routes": [{ "pattern": "groups.glossquote.com", "custom_domain": true }]
}
